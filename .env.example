# ==========================================
# JobRadar Environment Configuration
# ==========================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your_secret_random_webhook_token_here
ALLOWED_CHAT_IDS=  # Comma-separated list of allowed Telegram user IDs. Leave empty to allow all with per-user rate limits.
OWNER_CHAT_ID=     # Telegram user ID of owner to receive daily run error alerts.

# Database (MongoDB Atlas M0 Free Tier or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=job_radar

# LLM Provider: 'gemini', 'openai', 'anthropic', or 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Embedding Provider: 'local' (sentence-transformers or fast TF-IDF fallback), 'gemini', 'openai', or 'mock'
EMBEDDING_PROVIDER=local

# Freehire API
FREEHIRE_BASE_URL=https://freehire.me/api/v1

# Target ATS Company Slugs (comma-separated)
GREENHOUSE_COMPANIES=cloudflare,stripe,gitlab,automattic
LEVER_COMPANIES=postman,netflix,spotify
ASHBY_COMPANIES=retool,linear,ramp

# Optional GitHub Actions Dispatch (for offloading heavy resume parsing if Vercel serverless times out)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=username/repo

# Operation Mode
DRY_RUN=false
LOG_LEVEL=INFO
